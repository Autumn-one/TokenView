<Window x:Class="TokenView.Wpf.SessionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokenView.Wpf"
        Title="TokenView · 会话详情" Width="1280" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <local:ClientIcon x:Name="ClientIconView" IconSize="20" Margin="0,0,8,0"
                                              VerticalAlignment="Center" />
                            <TextBlock x:Name="TitleText" Text="会话详情" Style="{DynamicResource CardTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText" Style="{DynamicResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="Token 用量" Style="{DynamicResource StatLabel}" />
                            <TextBlock x:Name="TokensText" Style="{DynamicResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="请求明细" Style="{DynamicResource StatLabel}" />
                            <TextBlock x:Name="RequestsText" Style="{DynamicResource StatValue}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="明细完整度" Style="{DynamicResource StatLabel}" />
                            <TextBlock x:Name="CoverageText" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock x:Name="ProjectText" Style="{DynamicResource MutedText}" />
                    <TextBlock x:Name="ModelText" Style="{DynamicResource MutedText}" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,10">
                    <StackPanel Width="110">
                        <TextBlock Text="输入" Style="{DynamicResource StatLabel}" />
                        <TextBlock x:Name="InputText" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="输出" Style="{DynamicResource StatLabel}" />
                        <TextBlock x:Name="OutputText" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="推理" Style="{DynamicResource StatLabel}" />
                        <TextBlock x:Name="ReasoningText" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="缓存读取" Style="{DynamicResource StatLabel}" />
                        <TextBlock x:Name="CacheReadText" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <StackPanel Width="110">
                        <TextBlock Text="缓存写入" Style="{DynamicResource StatLabel}" />
                        <TextBlock x:Name="CacheWriteText" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <StackPanel Width="130">
                        <TextBlock Text="总量依据" Style="{DynamicResource StatLabel}" />
                        <TextBlock x:Name="BasisText" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="CoverageHintText" Style="{DynamicResource MutedText}"
                               VerticalAlignment="Bottom" Margin="8,0,0,3" />
                </StackPanel>
                <DataGrid Grid.Row="3" x:Name="MessagesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeaderWidth="0" Background="Transparent"
                          Foreground="{DynamicResource TextBrush}"
                          BorderThickness="0" RowHeight="34" ColumnHeaderHeight="32"
                          HorizontalScrollBarVisibility="Auto"
                          ColumnHeaderStyle="{StaticResource GridHeader}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="序号" Binding="{Binding Seq}" Width="52" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="开始" Binding="{Binding Time}" Width="138" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="结束" Binding="{Binding Completed}" Width="138" />
                        <DataGridTemplateColumn Header="模型" Width="155">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:ModelBadge Model="{Binding Model}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="代理" Binding="{Binding Agent}" Width="90" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="输入" Binding="{Binding InputText}" Width="82" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="输出" Binding="{Binding OutputText}" Width="82" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="推理" Binding="{Binding ReasoningText}" Width="82" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="缓存读取" Binding="{Binding CacheReadText}" Width="88" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="缓存写入" Binding="{Binding CacheWriteText}" Width="88" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="总量" Binding="{Binding TotalText}" Width="88" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="来源" Binding="{Binding SourceKind}" Width="64" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="引用" Binding="{Binding SourceRef}" Width="150" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="状态" Binding="{Binding Status}" Width="260" />
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock x:Name="PageText" Style="{DynamicResource MutedText}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PrevButton" Content="上一页" Style="{DynamicResource LinkButton}"
                                Width="90" Margin="0,0,8,0" Click="Prev_Click" />
                        <Button x:Name="NextButton" Content="下一页" Style="{DynamicResource LinkButton}"
                                Width="90" Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
