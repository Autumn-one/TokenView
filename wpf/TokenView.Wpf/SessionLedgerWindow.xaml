<Window x:Class="TokenView.Wpf.SessionLedgerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TokenView.Wpf.Controls"
        xmlns:local="clr-namespace:TokenView.Wpf"
        Title="TokenView · 会话总账" Width="1100" Height="740"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="会话总账" Style="{DynamicResource CardTitle}" />
                        <TextBlock x:Name="RangeText" Style="{DynamicResource MutedText}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="今日 Token" Style="{DynamicResource StatLabel}" />
                            <TextBlock x:Name="TodayTokensText" Style="{DynamicResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="区间 Token" Style="{DynamicResource StatLabel}" />
                            <TextBlock x:Name="TokensText" Style="{DynamicResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="会话数" Style="{DynamicResource StatLabel}" />
                            <TextBlock x:Name="SessionsText" Style="{DynamicResource StatValue}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="请求明细" Style="{DynamicResource StatLabel}" />
                            <TextBlock x:Name="MessagesText" Style="{DynamicResource StatValue}" />
                            <TextBlock x:Name="CacheHintText" Style="{DynamicResource MutedText}" />
                        </StackPanel>
                        <Button Content="关闭" Style="{DynamicResource LinkButton}" VerticalAlignment="Center"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <controls:RequestLineChart x:Name="DailyChart" Height="220"
                                               Accent="{DynamicResource AccentBrush}"
                                               GridBrush="{DynamicResource ChartGridBrush}"
                                               MutedBrush="{DynamicResource MutedBrush}"
                                               MouseMove="DailyChart_MouseMove"
                                               MouseLeave="DailyChart_MouseLeave" />
                    <Canvas x:Name="ChartOverlay" IsHitTestVisible="False">
                        <Border x:Name="ChartTooltip" Visibility="Collapsed"
                                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12" MinWidth="210">
                            <StackPanel>
                                <TextBlock x:Name="TooltipTitle" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="TooltipTokens" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="TooltipExact" FontSize="10" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock x:Name="TooltipSessions" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextBrush}" />
                                <ItemsControl x:Name="TooltipBreakdown" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <local:ClientIcon ClientKey="{Binding ClientKey}" IconSize="12"
                                                                  IconBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                                  VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                                           Foreground="{DynamicResource TextBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="NoteText" Text="单位：Token · 按会话开始日"
                           Style="{DynamicResource MutedText}" Margin="0,8,0,0" />
                <ItemsControl Grid.Row="3" x:Name="ClientList" Margin="0,6,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                <local:ClientIcon ClientKey="{Binding Client.Key}" IconSize="13"
                                                  IconBrush="{Binding Client.ColorHex, Converter={StaticResource HexToBrush}}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Client.Label}" FontSize="11" Margin="6,0,4,0"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Text="{Binding TokenText}" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <TextBlock Text="{Binding EstimateText}" FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid Grid.Row="4" x:Name="SessionsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="None" RowHeaderWidth="0" Background="Transparent"
                          Foreground="{DynamicResource TextBrush}"
                          BorderThickness="0" RowHeight="34" ColumnHeaderHeight="32"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          MouseDoubleClick="SessionsGrid_DoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="开始时间" Binding="{Binding Started}" Width="145" />
                        <DataGridTemplateColumn Header="客户端" Width="145">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:ClientIcon ClientKey="{Binding ClientKey}" IconSize="14"
                                                          IconBrush="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                          VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ClientLabel}" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="模型" Width="155">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <local:ModelBadge Model="{Binding Model}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="项目" Binding="{Binding Project}" Width="*" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="请求" Binding="{Binding RequestsText}" Width="70" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="Token" Binding="{Binding TokenText}" Width="90" />
                        <DataGridTextColumn ElementStyle="{StaticResource GridCellText}" Header="状态" Binding="{Binding Coverage}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
