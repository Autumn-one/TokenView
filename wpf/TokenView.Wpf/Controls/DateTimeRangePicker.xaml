<UserControl x:Class="TokenView.Wpf.Controls.DateTimeRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="600"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown"
             FontFamily="Microsoft YaHei UI">
    <UserControl.Resources>
        <Style x:Key="MonthNavButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarDayButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WeekdayText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,7,0,4" />
        </Style>

        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="46" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="220" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <DataTemplate x:Key="DayCellTemplate">
            <Button Style="{StaticResource CalendarDayButton}"
                    Tag="{Binding Date}"
                    AutomationProperties.Name="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                    ToolTip="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                    Click="Day_Click"
                    MouseEnter="Day_MouseEnter">
                <Grid Height="30">
                    <Border x:Name="RangeBg" Background="Transparent" Margin="0,3" />
                    <Border x:Name="TodayRing" Width="30" Height="30" CornerRadius="15"
                            BorderBrush="Transparent" BorderThickness="1" />
                    <Border x:Name="EdgeBg" Width="30" Height="30" CornerRadius="15"
                            Background="Transparent" />
                    <TextBlock x:Name="DayText" Text="{Binding Day}" FontSize="12"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInRange}" Value="True">
                    <Setter TargetName="RangeBg" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEdge}" Value="True">
                    <Setter TargetName="EdgeBg" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="DayText" Property="Foreground" Value="White" />
                    <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="TodayRing" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter TargetName="DayText" Property="Opacity" Value="0.35" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="‹" Style="{StaticResource MonthNavButton}"
                    AutomationProperties.Name="上一个月"
                    Click="PreviousMonth_Click" ToolTip="上一个月" />
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftMonthTitle" Grid.Column="0" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="RightMonthTitle" Grid.Column="2" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <Button Grid.Column="2" Content="›" Style="{StaticResource MonthNavButton}"
                    AutomationProperties.Name="下一个月"
                    Click="NextMonth_Click" ToolTip="下一个月" />
        </Grid>

        <Grid Margin="0,2,0,0" MouseLeave="CalendarArea_MouseLeave">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <UniformGrid Columns="7">
                    <TextBlock Text="一" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="二" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="三" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="四" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="五" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="六" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="日" Style="{StaticResource WeekdayText}" />
                </UniformGrid>
                <ItemsControl x:Name="LeftDays" Height="192" ItemTemplate="{StaticResource DayCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <UniformGrid Columns="7">
                    <TextBlock Text="一" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="二" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="三" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="四" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="五" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="六" Style="{StaticResource WeekdayText}" />
                    <TextBlock Text="日" Style="{StaticResource WeekdayText}" />
                </UniformGrid>
                <ItemsControl x:Name="RightDays" Height="192" ItemTemplate="{StaticResource DayCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0"
                Padding="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="开始" Style="{DynamicResource StatLabel}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StartDateText" Text="未选择" Width="68" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="6,0" />
                        <ComboBox x:Name="StartHour" AutomationProperties.Name="开始小时"
                                  SelectionChanged="Time_Changed" />
                        <TextBlock Text=":" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="3,0" />
                        <ComboBox x:Name="StartMinute" AutomationProperties.Name="开始分钟"
                                  SelectionChanged="Time_Changed" />
                        <TextBlock Text="结束" Style="{DynamicResource StatLabel}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                        <TextBlock x:Name="EndDateText" Text="未选择" Width="68" FontSize="11"
                                   Foreground="{DynamicResource TextBrush}" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="6,0" />
                        <ComboBox x:Name="EndHour" AutomationProperties.Name="结束小时"
                                  SelectionChanged="Time_Changed" />
                        <TextBlock Text=":" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="3,0" />
                        <ComboBox x:Name="EndMinute" AutomationProperties.Name="结束分钟"
                                  SelectionChanged="Time_Changed" />
                    </StackPanel>
                    <TextBlock x:Name="HintText" Text="本地时区 · 包含结束分钟" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                    <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="清空" Style="{DynamicResource LinkButton}" Height="30" Padding="12,4"
                            Margin="0,0,8,0" Click="Clear_Click" />
                    <Button Content="确定" Style="{StaticResource ConfirmButton}" Height="30"
                            Click="Confirm_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
