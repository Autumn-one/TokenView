<UserControl x:Class="TokenView.Wpf.ModelBadge"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TokenView.Wpf">
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource ChipBrush}"
                Margin="0,0,6,0" VerticalAlignment="Center">
            <local:ModelIcon Model="{Binding Model, ElementName=Root}" IconSize="13"
                             IconBrush="{DynamicResource MutedBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Model, ElementName=Root}" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
