<Window x:Class="TokenView.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TokenView.Wpf.Controls"
        Title="TokenView · 设置" Width="940" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="24">
        <Border Style="{DynamicResource CardStyle}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                        Background="{DynamicResource SidebarBrush}" CornerRadius="12,0,0,12">
                    <StackPanel Margin="18,22">
                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="偏好设置" Style="{DynamicResource MutedText}" Margin="0,4,0,18" />
                        <ListBox x:Name="NavList" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="Nav_SelectionChanged">
                            <ListBoxItem Content="通用" Tag="0" Padding="10,9" />
                            <ListBoxItem Content="外观与统计" Tag="1" Padding="10,9" />
                            <ListBoxItem Content="采集" Tag="2" Padding="10,9" />
                            <ListBoxItem Content="局域网" Tag="3" Padding="10,9" />
                            <ListBoxItem Content="更新" Tag="4" Padding="10,9" />
                            <ListBoxItem Content="数据与隐私" Tag="5" Padding="10,9" />
                            <ListBoxItem Content="关于" Tag="6" Padding="10,9" />
                        </ListBox>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30,24,30,28">
                        <StackPanel x:Name="GeneralPanel">
                            <TextBlock Text="通用" Style="{DynamicResource SectionTitle}" />
                            <TextBlock Text="窗口、启动与关闭行为。" Style="{DynamicResource MutedText}" Margin="0,4,0,22" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关闭主窗口时" Style="{DynamicResource StatLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="CloseBehaviorBox" Width="230"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="每次询问" Tag="ask" />
                                    <ComboBoxItem Content="最小化到托盘" Tag="tray" />
                                    <ComboBoxItem Content="直接退出" Tag="exit" />
                                </ComboBox>
                            </Grid>
                            <CheckBox x:Name="AutostartCheck" Content="开机自启" Margin="0,4,0,10"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="AutostartHiddenCheck" Content="开机启动时隐藏到托盘" Margin="0,0,0,10"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="RememberWindowCheck" Content="记住窗口尺寸与位置"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <TextBlock Text="当前 WPF 实验版尚未接管系统托盘与窗口状态持久化，设置会写入现有 settings.json。"
                                       Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,18,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <TextBlock Text="外观与统计" Style="{DynamicResource SectionTitle}" />
                            <TextBlock Text="主题、Token 格式与默认日期范围。" Style="{DynamicResource MutedText}" Margin="0,4,0,22" />
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="主题" Style="{DynamicResource StatLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="ThemeBox" Width="230"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="跟随系统" Tag="system" />
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Token 显示" Style="{DynamicResource StatLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="TokenDisplayBox" Width="230"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="自动" Tag="auto" />
                                    <ComboBoxItem Content="中文单位" Tag="chinese" />
                                    <ComboBoxItem Content="K" Tag="k" />
                                    <ComboBoxItem Content="M" Tag="m" />
                                    <ComboBoxItem Content="B" Tag="b" />
                                    <ComboBoxItem Content="精确值" Tag="exact" />
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="默认统计范围" Style="{DynamicResource StatLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="DefaultRangeBox" Width="230"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="今天" Tag="today" />
                                    <ComboBoxItem Content="最近 7 天" Tag="7d" />
                                    <ComboBoxItem Content="本周" Tag="week" />
                                    <ComboBoxItem Content="本月" Tag="month" />
                                    <ComboBoxItem Content="最近 30 天" Tag="30d" />
                                    <ComboBoxItem Content="最近 90 天" Tag="90d" />
                                    <ComboBoxItem Content="全部" Tag="all" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="CollectionPanel" Visibility="Collapsed">
                            <TextBlock Text="采集" Style="{DynamicResource SectionTitle}" />
                            <TextBlock Text="采集开关、频率与客户端来源。" Style="{DynamicResource MutedText}" Margin="0,4,0,22" />
                            <CheckBox x:Name="PausedCheck" Content="暂停采集（保留历史）" Margin="0,0,0,10"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <CheckBox x:Name="SyncOnStartCheck" Content="启动时采集" Margin="0,0,0,10"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="后台采集频率" Style="{DynamicResource StatLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" x:Name="SyncIntervalBox" Width="230"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          SelectionChanged="Setting_Changed">
                                    <ComboBoxItem Content="关闭" Tag="0" />
                                    <ComboBoxItem Content="每 1 分钟" Tag="1" />
                                    <ComboBoxItem Content="每 5 分钟" Tag="5" />
                                    <ComboBoxItem Content="每 15 分钟" Tag="15" />
                                    <ComboBoxItem Content="每 30 分钟" Tag="30" />
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="客户端来源" Style="{DynamicResource StatLabel}" Margin="0,4,0,8" />
                            <StackPanel x:Name="ClientListPanel" />
                            <TextBlock Text="重扫会重新读取该客户端当前可访问的数据；缺失字段保持未知，不估算、不补零。"
                                       Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="LanPanel" Visibility="Collapsed">
                            <TextBlock Text="局域网" Style="{DynamicResource SectionTitle}" />
                            <TextBlock Text="同一局域网内的 TokenView 会自动发现并交换聚合用量；默认开启，可随时关闭。"
                                       Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,22" />

                            <CheckBox x:Name="LanSyncCheck"
                                      Content="启用局域网自动发现与同步"
                                      Margin="0,0,0,14" />
                            <TextBlock Text="设备名称（会显示在其他电脑的列表中）" Style="{DynamicResource StatLabel}" />
                            <TextBox x:Name="LanDeviceNameText" MaxLength="64" Margin="0,6,0,16" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Button Content="保存并应用" Style="{DynamicResource LinkButton}"
                                        Click="LanApply_Click" Margin="0,0,16,0" />
                                <Button Content="立即同步" Style="{DynamicResource LinkButton}"
                                        Click="LanSyncNow_Click" Margin="0,0,16,0" />
                                <Button Content="重置设备标识" Style="{DynamicResource LinkButton}"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Click="ResetLanIdentity_Click" />
                            </StackPanel>

                            <TextBlock x:Name="LanStatusText" Style="{DynamicResource StatLabel}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="LanLastImportText" Style="{DynamicResource MutedText}"
                                       FontSize="11" Margin="0,3,0,0" />
                            <TextBlock x:Name="LanErrorText" Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="Collapsed" />

                            <TextBlock Text="发现的设备" Style="{DynamicResource StatLabel}"
                                       Margin="0,18,0,8" />
                            <ItemsControl x:Name="LanPeerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="8"
                                                Padding="10,8" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock Text="{Binding OnlineText}" Margin="8,0,0,0"
                                                                   Style="{DynamicResource MutedText}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DetailText}" Style="{DynamicResource MutedText}"
                                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SnapshotText, StringFormat='快照：{0}'}"
                                                               Style="{DynamicResource MutedText}" FontSize="11" />
                                                    <TextBlock Text="{Binding ImportedText, StringFormat='导入：{0}'}"
                                                               Style="{DynamicResource MutedText}" FontSize="11" />
                                                    <TextBlock Text="{Binding WaitingText}" Style="{DynamicResource MutedText}"
                                                               FontSize="11" />
                                                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}"
                                                               FontSize="11" TextWrapping="Wrap"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="移除" Tag="{Binding DeviceId}"
                                                        Style="{DynamicResource LinkButton}"
                                                        VerticalAlignment="Top" Margin="12,0,0,0"
                                                        Click="RemoveLanPeer_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="LanNoPeers"
                                       Text="尚未发现其他电脑。请确认两台电脑在同一专用网络，并允许 TokenView 通过 Windows 防火墙。"
                                       Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" />

                            <TextBlock Text="只交换每台电脑的 Token / 请求 / 会话计数与客户端、模型聚合，不读取或传输会话正文、项目路径、会话标识或原始数据库。局域网内能访问本机端口的人可以读取这些聚合数据；共享网络请谨慎开启。首次启动时 Windows 可能询问是否允许 TokenView 通过防火墙，请选择专用网络。"
                                       Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="UpdatePanel" Visibility="Collapsed">
                            <TextBlock Text="更新" Style="{DynamicResource SectionTitle}" />
                            <TextBlock Text="仅访问固定 GitHub Release 端点。开启自动更新后会下载并校验更新包，重启由你确认。"
                                       Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,22" />
                            <CheckBox x:Name="AutomaticUpdatesCheck" Content="自动检查并下载更新（最多每天一次）"
                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                            <TextBlock x:Name="LastUpdateText" Style="{DynamicResource MutedText}" Margin="0,14,0,0" />
                            <Button x:Name="CheckUpdateButton" Content="检查更新" Style="{DynamicResource LinkButton}" Margin="0,18,0,0"
                                    Click="CheckUpdate_Click" />
                            <TextBlock x:Name="UpdateResultText" Style="{DynamicResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" />
                            <Button x:Name="DownloadUpdateButton" Content="下载并准备更新" Style="{DynamicResource LinkButton}"
                                    Margin="0,10,0,0" Visibility="Collapsed" Click="DownloadUpdate_Click" />
                            <Button x:Name="InstallUpdateButton" Content="重启并更新" Style="{DynamicResource LinkButton}"
                                    Margin="0,10,0,0" Visibility="Collapsed" Click="InstallUpdate_Click" />
                            <Button x:Name="OpenReleasePageButton" Content="打开下载页" Style="{DynamicResource LinkButton}"
                                    Margin="0,10,0,0" Click="OpenReleasePage_Click" />
                        </StackPanel>

                        <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                            <TextBlock Text="数据与隐私" Style="{DynamicResource SectionTitle}" />
                            <TextBlock Text="统计数据库、设置文件与清除操作。" Style="{DynamicResource MutedText}" Margin="0,4,0,22" />
                            <TextBlock Text="统计数据库" Style="{DynamicResource StatLabel}" />
                            <TextBox x:Name="DatabasePathText" IsReadOnly="True" Margin="0,6,0,16"
                                     Background="{DynamicResource ChipBrush}" BorderThickness="0" Padding="8" />
                            <TextBlock Text="设置文件" Style="{DynamicResource StatLabel}" />
                            <TextBox x:Name="SettingsPathText" IsReadOnly="True" Margin="0,6,0,20"
                                     Background="{DynamicResource ChipBrush}" BorderThickness="0" Padding="8" />
                            <Button Content="打开数据目录" Style="{DynamicResource LinkButton}" Width="130"
                                    HorizontalAlignment="Left" Click="OpenDataFolder_Click" Margin="0,0,0,12" />
                            <Button Content="迁移存储目录" Style="{DynamicResource LinkButton}" Width="130"
                                    HorizontalAlignment="Left" Click="Relocate_Click" Margin="0,0,0,12" />
                            <Button Content="恢复默认设置" Style="{DynamicResource LinkButton}" Width="130"
                                    HorizontalAlignment="Left" Click="ResetSettings_Click" Margin="0,0,0,12" />
                            <Button Content="清除全部统计数据" Style="{DynamicResource LinkButton}" Width="160"
                                    HorizontalAlignment="Left" Foreground="{DynamicResource DangerBrush}" Click="ClearStatistics_Click" />
                            <TextBlock Text="只清除 TokenView 自有统计数据库，不修改任何客户端原始会话文件。"
                                       Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="关于 TokenView" Style="{DynamicResource SectionTitle}" />
                                <TextBlock x:Name="AboutVersionText" Text="版本 0.1.10"
                                           Style="{DynamicResource StatLabel}"
                                           Margin="8,0,0,2" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock Text="本地优先的 AI 编程客户端用量统计。" Style="{DynamicResource MutedText}" Margin="0,4,0,22" />

                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,20" />

                            <Grid>
                                <TextBlock Text="动态信息" Style="{DynamicResource SectionTitle}" />
                                <Button x:Name="AboutRetryButton" Content="重试"
                                        Style="{DynamicResource LinkButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Visibility="Collapsed" Click="AboutRetry_Click" />
                            </Grid>
                            <TextBlock x:Name="AboutInfoStatusText" Style="{DynamicResource MutedText}"
                                       Margin="0,10,0,0" />
                            <TextBlock x:Name="AboutInfoErrorText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="AboutInfoStateText" Style="{DynamicResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                            <controls:MarkdownView x:Name="AboutMarkdown" Margin="0,8,0,0"
                                                   VerticalScrollBarVisibility="Disabled"
                                                   PreviewMouseWheel="AboutMarkdown_PreviewMouseWheel"
                                                   Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
