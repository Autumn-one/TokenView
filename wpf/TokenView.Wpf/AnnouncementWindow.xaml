<Window x:Class="TokenView.Wpf.AnnouncementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TokenView.Wpf.Controls"
        Title="TokenView · 公告" Width="760" Height="660" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="公告" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <Border x:Name="UnreadChip" Background="{DynamicResource AccentSoftBrush}"
                        CornerRadius="6" Padding="6,2" Margin="10,1,0,0" Visibility="Collapsed">
                    <TextBlock Text="未读" FontSize="10.5" Foreground="{DynamicResource AccentDarkBrush}" />
                </Border>
                <TextBlock x:Name="UpdatedText" Style="{DynamicResource MutedText}"
                           Margin="12,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="RefreshButton" Content="刷新" Style="{DynamicResource LinkButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Refresh_Click" AutomationProperties.Name="刷新公告" />
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="22,18" Margin="0,14,0,0">
            <Grid>
                <controls:MarkdownView x:Name="MarkdownViewer" Visibility="Collapsed" />
                <StackPanel x:Name="StatePanel" VerticalAlignment="Center"
                            HorizontalAlignment="Center" MaxWidth="420">
                    <TextBlock x:Name="StateTitle" Text="正在获取公告…" FontSize="14"
                               FontWeight="SemiBold" TextAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="StateHint"
                               Text="内容来自公开仓库，只在内存中展示，不保存正文。"
                               Style="{DynamicResource MutedText}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ErrorBar" Grid.Row="2" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="RetryButton" Grid.Column="1" Content="重试"
                    Style="{DynamicResource LinkButton}" Margin="12,0,0,0"
                    VerticalAlignment="Center" Click="Retry_Click" />
        </Grid>
    </Grid>
</Window>
