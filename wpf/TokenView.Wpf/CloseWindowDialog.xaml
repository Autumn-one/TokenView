<Window x:Class="TokenView.Wpf.CloseWindowDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 TokenView" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource WindowBrush}"
        FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="24">
        <TextBlock Text="关闭主窗口时" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" />
        <TextBlock Text="最小化到托盘后，TokenView 仍会按设置继续采集；退出则完全停止采集。"
                   Style="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16" />
        <CheckBox x:Name="RememberCheck" Content="记住我的选择" Margin="0,0,0,18" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{DynamicResource LinkButton}" Width="80"
                    Click="Cancel_Click" Margin="0,0,8,0" />
            <Button Content="退出" Style="{DynamicResource LinkButton}" Width="80"
                    Click="Exit_Click" Margin="0,0,8,0" />
            <Button Content="最小化到托盘" Style="{DynamicResource LinkButton}" Width="120"
                    Click="Tray_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
